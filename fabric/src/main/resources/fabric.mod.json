{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_author}"],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      { "adapter": "kotlin", "value": "xyz.thewhish.substratum.fabric.SubstratumFabric" }
    ],
    "client": [
      { "adapter": "kotlin", "value": "xyz.thewhish.substratum.fabric.client.SubstratumFabricClient" }
    ]
  },
  "mixins": ["substratum-common.mixins.json", "substratum-fabric.mixins.json"],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "architectury": ">=${architectury_version}",
    "immersive_portals": ">=6.1.0"
  }
}
