import { Theme } from "theme.slint";

export enum WindowAction { minimize, close }

export component Marker inherits Rectangle {
    in property <bool> left;
    in property <int> size: 4;
    in property <color> ink: Theme.text;

    width: root.size * 1px;
    height: root.size * 2px;

    for column in root.size: Rectangle {
        x: (root.left ? root.size - 1 - column : column) * 1px;
        y: column * 1px;
        width: 1px;
        height: (root.size - column) * 2px;
        background: root.ink;
    }
}

export component RecDot inherits Rectangle {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: Theme.rec;
}

export component Osd inherits Text {
    color: Theme.text-mute;
    font-size: Theme.osd-size;
    letter-spacing: Theme.osd-spacing;
    height: Theme.osd-line;
    vertical-alignment: center;
}

export component MenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback activated();

    height: Theme.menu-item;

    Marker {
        x: 0px;
        y: (root.height - self.height) / 2;
        size: 5;
        opacity: root.active ? 1 : 0;
        animate opacity { duration: Theme.hover; easing: ease-out; }
    }

    Text {
        x: 17px;
        height: root.height;
        text: root.label;
        color: root.active || area.has-hover ? Theme.text : Theme.text-mute;
        font-size: Theme.menu-size;
        vertical-alignment: center;
        animate color { duration: Theme.hover; easing: ease-out; }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

export component WindowButton inherits Rectangle {
    in property <WindowAction> action;
    callback clicked();

    property <color> ink: !area.has-hover ? Theme.text-mute : root.action == WindowAction.close ? Theme.rec : Theme.text;

    width: 31px;
    height: 31px;

    if root.action == WindowAction.minimize: Rectangle {
        width: 11px;
        height: 1px;
        background: root.ink;
    }
    if root.action == WindowAction.close: Rectangle {
        width: 11px;
        height: 11px;

        for step in 11: Rectangle {
            x: step * 1px;
            y: step * 1px;
            width: 1px;
            height: 1px;
            background: root.ink;
        }
        for step in 11: Rectangle {
            x: (10 - step) * 1px;
            y: step * 1px;
            width: 1px;
            height: 1px;
            background: root.ink;
        }
    }

    area := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component PanelHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> detail;

    height: Theme.osd-line;

    Osd { text: root.title; letter-spacing: 1.5px; horizontal-stretch: 1; }
    Rectangle {
        width: detail.preferred-width;

        detail := Osd { x: 3px; text: root.detail; letter-spacing: 1.5px; }
    }
}

export component SlotCard inherits Rectangle {
    in property <string> number;
    in property <string> nick;
    in property <bool> host;

    property <bool> taken: root.nick != "";

    min-height: 124px;
    border-width: 1px;
    border-color: root.taken ? Theme.line : Theme.line-dim;

    VerticalLayout {
        padding: 12px;

        HorizontalLayout {
            Osd {
                text: root.number;
                color: root.taken ? Theme.text-mute : Theme.text-dim;
                horizontal-stretch: 1;
            }
            if root.host: Osd { text: @tr("ХОСТ"); color: Theme.text; }
        }

        Rectangle { vertical-stretch: 1; }

        if root.taken: HorizontalLayout {
            spacing: 12px;

            Rectangle {
                width: 56px;
                height: 56px;
                background: #6b4f33;

                Rectangle {
                    y: parent.height - self.height;
                    height: 20px;
                    background: #3d2c1c;
                }
            }
            Text {
                text: root.nick;
                color: Theme.text;
                font-size: 16px;
                vertical-alignment: bottom;
                overflow: elide;
            }
        }
        if !root.taken: Text {
            text: @tr("СВОБОДНО");
            color: Theme.text-dim;
            font-size: Theme.body-size;
            height: 20px;
            vertical-alignment: bottom;
        }
    }
}

export component CodeCells inherits HorizontalLayout {
    in property <[string]> chars;
    in property <int> cursor: -1;
    in property <bool> blink;
    in property <int> flash: -100;

    spacing: 4px;
    height: 40px;
    alignment: start;

    for index in 9: Rectangle {
        property <int> slot: index < 4 ? index : index - 1;
        property <string> char: index == 4 ? "" : root.chars[self.slot];
        property <bool> lit: index != 4 && root.flash >= self.slot && root.flash < self.slot + 6;

        width: index == 4 ? 16px : 32px;
        border-width: index == 4 ? 0px : 1px;
        border-color: self.lit || (self.slot == root.cursor && index != 4) ? Theme.text : self.char != "" ? Theme.text-dim : Theme.line;
        background: self.lit ? Theme.text : transparent;
        animate background, border-color { duration: 180ms; easing: ease-out; }

        Text {
            text: index == 4 ? "-" : parent.char;
            color: index == 4 ? Theme.text-dim : parent.lit ? Theme.bg : Theme.text;
            font-size: Theme.code-size;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 180ms; easing: ease-out; }
        }

        if index != 4 && (index < 4 ? index : index - 1) == root.cursor && root.blink: Rectangle {
            width: 10px;
            height: 18px;
            background: Theme.text;
        }
    }
}

export component Setting inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> selector;
    in property <bool> action;
    callback activated();

    height: Theme.row;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line-faint;
    }

    HorizontalLayout {
        spacing: Theme.inner-gap;

        Text {
            text: root.label;
            color: root.action ? Theme.text : Theme.text-mute;
            font-size: Theme.body-size;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 12px;
            horizontal-stretch: 0;

            if root.selector: VerticalLayout {
                alignment: center;
                Marker { left: true; ink: Theme.text-mute; }
            }
            if root.value != "": Text {
                text: root.value;
                color: Theme.text;
                font-size: Theme.body-size;
                vertical-alignment: center;
            }
            if root.selector || root.action: VerticalLayout {
                alignment: center;
                Marker { ink: root.action && area.has-hover ? Theme.text : Theme.text-mute; }
            }
        }
    }

    area := TouchArea {
        enabled: root.action;
        mouse-cursor: root.action ? pointer : default;
        clicked => { root.activated(); }
    }
}

export component LaunchButton inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    callback clicked();

    property <bool> hot: area.has-hover;

    height: Theme.launch;
    border-width: 1px;
    border-color: Theme.text;
    background: root.hot ? Theme.text : transparent;
    animate background { duration: Theme.hover; easing: ease-out; }

    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            Marker { size: 7; ink: root.hot ? Theme.bg : Theme.text; }
        }
        Text {
            text: root.label;
            color: root.hot ? Theme.bg : Theme.text;
            font-size: Theme.menu-size;
            letter-spacing: 2px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            animate color { duration: Theme.hover; easing: ease-out; }
        }
        Osd {
            text: root.hint;
            height: root.height;
            color: root.hot ? #3a3830 : Theme.text-mute;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
