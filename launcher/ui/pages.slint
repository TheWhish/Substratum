import { Theme } from "theme.slint";
import { CodeCells, LaunchButton, Marker, Osd, PanelHeader, Route, Setting, Slot, SlotCard } from "widgets.slint";

export component PlayPanel inherits VerticalLayout {
    in property <[Slot]> slots;
    in property <bool> online;
    in property <Route> route;
    in property <string> team-code;
    in property <[string]> team-cells;
    in property <[string]> join-cells;
    in-out property <string> join-text;
    in property <bool> blink;
    in property <bool> busy;
    in property <bool> installed;
    in property <bool> playing;
    callback join-edited(string);
    callback join();
    callback leave();
    callback kick(int);
    callback launch();
    callback cancel();

    property <length> card-width: (root.width - 3 * Theme.inner-gap) / 4;
    property <length> code-width: 8 * 32px + 7 * 4px + 16px + 4px;
    property <int> flash: -100;
    property <bool> copied;
    property <bool> join-ready: root.join-text.character-count == 8;

    function copy-code() {
        if root.team-code == "" {
            return;
        }
        clipboard.select-all();
        clipboard.copy();
        clipboard.clear-selection();
        root.flash = 0;
        root.copied = true;
        flash-timer.running = true;
        copied-timer.running = true;
        copied-timer.restart();
    }

    spacing: 0px;

    flash-timer := Timer {
        interval: 35ms;
        running: false;
        triggered => {
            root.flash += 1;
            if root.flash > 14 {
                root.flash = -100;
                self.running = false;
            }
        }
    }

    copied-timer := Timer {
        interval: Theme.message;
        running: false;
        triggered => {
            root.copied = false;
            self.running = false;
        }
    }

    clipboard := TextInput {
        width: 0px;
        height: 0px;
        text: root.team-code;
        read-only: true;
        visible: false;
    }

    HorizontalLayout {
        spacing: Theme.inner-gap;

        PanelHeader {
            title: @tr("КОМАНДА");
            detail: !root.online ? @tr("НЕТ СВЯЗИ")
                : root.route == Route.direct ? @tr("НАПРЯМУЮ")
                : root.route == Route.relay ? @tr("ЧЕРЕЗ СЕРВЕР")
                : root.slots.length + " / 4";
        }
        if root.slots.length > 1: Osd {
            text: @tr("ПОКИНУТЬ");
            color: leave-area.has-hover ? Theme.text : Theme.text-mute;
            animate color { duration: Theme.hover; easing: ease-out; }

            leave-area := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.leave(); }
            }
        }
    }
    Rectangle { height: Theme.inner-gap; }

    HorizontalLayout {
        spacing: Theme.inner-gap;
        vertical-stretch: 1;
        for index in 4: SlotCard {
            width: root.card-width;
            number: "0" + (index + 1);
            slot: root.slots[index];
            kick => { root.kick(index); }
            clicked => { root.copy-code(); }
        }
    }

    Rectangle { height: Theme.gap; }

    HorizontalLayout {
        spacing: Theme.inner-gap;

        VerticalLayout {
            spacing: 8px;
            width: (root.width - Theme.inner-gap) / 2;

            HorizontalLayout {
                width: root.code-width;
                Osd { text: @tr("КОД КОМАНДЫ"); horizontal-stretch: 1; }
                Osd {
                    text: root.copied ? @tr("СКОПИРОВАНО") : @tr("КОПИРОВАТЬ");
                    color: root.copied ? Theme.tape : copy-area.has-hover ? Theme.text : Theme.text-mute;
                    animate color { duration: Theme.hover; easing: ease-out; }

                    copy-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy-code(); }
                    }
                }
            }
            Rectangle {
                width: root.code-width;
                height: 40px;

                CodeCells { chars: root.team-cells; flash: root.flash; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.copy-code(); }
                }
            }
        }

        VerticalLayout {
            spacing: 8px;
            width: (root.width - Theme.inner-gap) / 2;

            HorizontalLayout {
                width: root.code-width;
                Osd { text: @tr("ВОЙТИ ПО КОДУ"); horizontal-stretch: 1; }
                Osd {
                    text: @tr("ВОЙТИ");
                    color: !root.join-ready ? Theme.text-dim : join-area.has-hover ? Theme.text : Theme.text-mute;

                    join-area := TouchArea {
                        enabled: root.join-ready;
                        mouse-cursor: pointer;
                        clicked => { root.join(); }
                    }
                }
            }
            Rectangle {
                width: root.code-width;
                height: 40px;

                CodeCells {
                    chars: root.join-cells;
                    cursor: input.has-focus && !root.join-ready ? root.join-text.character-count : -1;
                    blink: root.blink;
                }
                input := TextInput {
                    text <=> root.join-text;
                    color: transparent;
                    selection-background-color: transparent;
                    selection-foreground-color: transparent;
                    text-cursor-width: 0px;
                    single-line: true;
                    edited => { root.join-edited(self.text); }
                    accepted => {
                        if root.join-ready {
                            root.join();
                        }
                    }
                }
            }
        }
    }

    Rectangle { height: Theme.gap; }

    LaunchButton {
        label: root.busy ? @tr("ОТМЕНИТЬ") : root.playing ? @tr("ИГРА ЗАПУЩЕНА") : root.installed ? @tr("ЗАПУСК") : @tr("УСТАНОВИТЬ");
        hint: root.busy ? "ESC" : root.playing ? "" : "ENTER";
        enabled: !root.playing;
        clicked => {
            if root.busy {
                root.cancel();
            } else {
                root.launch();
            }
        }
    }
}

component SkinTile inherits Rectangle {
    in property <image> figure;
    in property <bool> selected;
    in property <bool> live: true;
    callback clicked();

    width: 48px;
    height: 80px;

    Image {
        width: 32px;
        height: 64px;
        source: root.figure;
        image-rendering: pixelated;
    }

    Rectangle {
        border-width: 1px;
        border-color: root.selected || (root.live && area.has-hover) ? Theme.text : Theme.line;
        animate border-color { duration: Theme.hover; easing: ease-out; }
    }

    area := TouchArea {
        mouse-cursor: root.live ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component ProfilePanel inherits HorizontalLayout {
    in-out property <string> nick;
    in property <[image]> presets;
    in property <int> skin;
    in property <image> front;
    in property <image> back;
    in property <bool> locked;
    callback nick-edited(string);
    callback select-skin(int);
    callback refused();

    property <bool> behind;
    property <int> length: root.nick.character-count;

    spacing: Theme.gap;

    VerticalLayout {
        spacing: 0px;
        horizontal-stretch: 1;

        PanelHeader { title: @tr("ПРОФИЛЬ"); }
        Rectangle { height: Theme.inner-gap; }
        HorizontalLayout {
            Osd { text: @tr("НИК"); horizontal-stretch: 1; }
            Osd {
                text: root.length + " / 16";
                color: root.length < 3 ? Theme.rec : Theme.text-dim;
            }
        }
        Rectangle { height: 8px; }
        Rectangle {
            height: 32px;

            nick-input := TextInput {
                x: 0px;
                width: parent.width;
                text <=> root.nick;
                read-only: root.locked;
                color: root.locked ? Theme.text-dim : Theme.text;
                font-size: Theme.code-size;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: Theme.line;
                selection-foreground-color: Theme.text;
                edited => { root.nick-edited(self.text); }
            }
            if root.locked: TouchArea {
                clicked => { root.refused(); }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: nick-input.has-focus ? Theme.text : Theme.text-dim;
                animate background { duration: Theme.hover; easing: ease-out; }
            }
        }
        Rectangle { height: Theme.gap; }
        Osd { text: @tr("СКИН"); }
        Rectangle { height: 8px; }
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            for figure[index] in root.presets: SkinTile {
                figure: figure;
                selected: root.skin == index;
                live: !root.locked;
                clicked => {
                    if root.locked {
                        root.refused();
                    } else {
                        root.select-skin(index);
                    }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
    }

    Rectangle {
        width: 180px;
        border-width: 1px;
        border-color: Theme.line;

        Image {
            y: (parent.height - Theme.osd-line - 12px - self.height) / 2;
            width: 112px;
            height: 224px;
            source: root.behind ? root.back : root.front;
            image-rendering: pixelated;
        }
        HorizontalLayout {
            y: parent.height - 12px - self.height;
            height: Theme.osd-line;
            spacing: 12px;
            alignment: center;

            VerticalLayout { alignment: center; Marker { left: true; ink: turn-area.has-hover ? Theme.text : Theme.text-mute; } }
            Osd { text: root.behind ? @tr("СПИНА") : @tr("ПЕРЕД"); }
            VerticalLayout { alignment: center; Marker { ink: turn-area.has-hover ? Theme.text : Theme.text-mute; } }
        }
        turn-area := TouchArea {
            y: parent.height - Theme.osd-line - 24px;
            height: Theme.osd-line + 24px;
            mouse-cursor: pointer;
            clicked => { root.behind = !root.behind; }
        }
    }
}

component Group inherits VerticalLayout {
    in property <string> title;

    spacing: 4px;

    Osd { text: root.title; letter-spacing: 1.5px; color: Theme.text-dim; }
    @children
}

export enum Choice { memory, window, language, after-launch }

export component SettingsPanel inherits GridLayout {
    in property <string> version;
    in property <string> build;
    in property <int> memory;
    in property <int> auto-memory;
    in property <int> window-mode;
    in property <int> language;
    in property <int> after-launch;
    in property <bool> locked;
    callback adjust(Choice, int);
    callback refused();
    callback repair();
    callback open-home();
    callback open-logs();
    callback open-screenshots();

    property <[string]> windows: [@tr("ПОЛНЫЙ ЭКРАН"), "1280 × 720", "1600 × 900", "1920 × 1080"];
    property <[string]> languages: ["РУССКИЙ", "ENGLISH"];
    property <[string]> afterwards: [@tr("СВЕРНУТЬ ЛАУНЧЕР"), @tr("ОСТАВИТЬ ОТКРЫТЫМ")];
    property <length> column: (root.width - Theme.gap) / 2;

    spacing-horizontal: Theme.gap;
    spacing-vertical: Theme.gap;

    Row {
        Group {
            width: root.column;
            title: @tr("ИГРА");
            Setting {
                label: @tr("ПАМЯТЬ");
                value: root.memory == 0 ? @tr("АВТО · {} ГБ", root.auto-memory) : @tr("{} ГБ", root.memory);
                selector: true;
                locked: root.locked;
                refused => { root.refused(); }
                stepped(delta) => { root.adjust(Choice.memory, delta); }
            }
            Setting {
                label: @tr("ОКНО");
                value: root.windows[root.window-mode];
                selector: true;
                locked: root.locked;
                refused => { root.refused(); }
                stepped(delta) => { root.adjust(Choice.window, delta); }
            }
            Setting {
                label: @tr("ЯЗЫК");
                value: root.languages[root.language];
                selector: true;
                locked: root.locked;
                refused => { root.refused(); }
                stepped(delta) => { root.adjust(Choice.language, delta); }
            }
            Setting {
                label: @tr("ПОСЛЕ ЗАПУСКА");
                value: root.afterwards[root.after-launch];
                selector: true;
                locked: root.locked;
                refused => { root.refused(); }
                stepped(delta) => { root.adjust(Choice.after-launch, delta); }
            }
        }
        Group {
            width: root.column;
            title: @tr("ФАЙЛЫ");
            Setting { label: @tr("ПАПКА ИГРЫ"); value: "%APPDATA%\\SUBSTRATUM"; action: true; activated => { root.open-home(); } }
            Setting { label: @tr("ПРОВЕРИТЬ И ПОЧИНИТЬ"); action: true; locked: root.locked; refused => { root.refused(); } activated => { root.repair(); } }
            Setting { label: @tr("ОТКРЫТЬ ЛОГИ"); action: true; activated => { root.open-logs(); } }
            Setting { label: @tr("ОТКРЫТЬ СКРИНШОТЫ"); action: true; activated => { root.open-screenshots(); } }
        }
    }
    Row {
        Group {
            width: root.column;
            title: @tr("О ПРОГРАММЕ");
            Setting { label: @tr("ЛАУНЧЕР"); value: "v" + root.version; }
            Setting { label: @tr("ВЕРСИЯ ИГРЫ"); value: root.build == "" ? "—" : root.build.to-uppercase(); }
            Setting { label: "MINECRAFT"; value: "1.21.1"; }
        }
        Group {
            width: root.column;
            title: " ";
            Setting { label: @tr("АВТОР"); value: "THEWHISH"; }
            Setting { label: @tr("ЛИЦЕНЗИЯ"); value: @tr("MIT · ШРИФТЫ OFL"); }
            Setting { label: @tr("ИНТЕРФЕЙС"); value: "MADE WITH SLINT"; }
        }
    }
}
