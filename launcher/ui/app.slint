import "../assets/fonts/IBMPlexMono-Regular.ttf";
import "../assets/fonts/IBMPlexMono-Medium.ttf";
import "../assets/fonts/VT323-Regular.ttf";
import { Theme } from "theme.slint";
import { Logo, VhsLayer } from "vhs.slint";
import { Marker, MenuItem, Osd, RecDot, Slot, WindowAction, WindowButton } from "widgets.slint";
import { Choice, PlayPanel, ProfilePanel, SettingsPanel } from "pages.slint";

export { Choice } from "pages.slint";

enum Panel { play, profile, settings }

export enum Outcome { done, cancelled, network, disk, corrupt, failed }

export enum Launch { started, nick, failed }

export enum Place { home, logs, screenshots, latest-log }

export enum Rejection { unknown, full, locked, nick-taken, failed }

export { Slot } from "widgets.slint";

export component AppWindow inherits Window {
    in property <string> version;
    in property <image> noise;
    in property <image> scanlines;
    in property <bool> tracking;
    in property <duration> tracking-time;
    in property <bool> logo-glitch;
    in property <length> glitch-shift;
    in property <int> seconds;
    in property <bool> blink;
    in property <string> team-code;
    in property <[string]> team-cells;
    in property <[string]> join-cells;
    in-out property <string> join-text;
    in-out property <string> nick;
    in property <[Slot]> slots;
    in property <bool> team-online;
    in property <image> front;
    in property <image> back;
    in property <[image]> presets;
    in property <int> skin;
    in property <string> build;
    in property <bool> busy;
    in property <bool> preparing;
    in property <float> progress;
    in property <float> speed;
    in property <bool> downloading;
    in-out property <bool> crashed;
    in property <bool> playing;
    in property <int> memory;
    in property <int> auto-memory;
    in property <int> window-mode;
    in property <int> language;
    in property <int> after-launch;
    callback quit();
    callback play() -> Launch;
    callback open(Place) -> bool;
    callback adjust(Choice, int);
    callback install();
    callback cancel();
    callback drag-window(length, length);
    callback join-edited(string);
    callback join-team(string);
    callback leave-team();
    callback kick(int);
    callback nick-edited(string);
    callback select-skin(int);

    property <Panel> panel: Panel.play;
    property <Panel> target: Panel.play;
    property <bool> rewinding;
    property <bool> sweeping;
    property <bool> powered;
    property <string> message;
    property <bool> alarm;

    title: "Substratum";
    no-frame: true;
    width: 1100px;
    height: 640px;
    background: Theme.bg;
    default-font-family: "IBM Plex Mono";
    default-font-size: Theme.body-size;
    forward-focus: keys;

    init => {
        root.powered = true;
    }

    states [
        sweeping when root.sweeping: {
            sweep.y: panel-area.height;
            in {
                animate sweep.y { duration: Theme.sweep; easing: ease-in; }
            }
        }
    ]

    function pad(value: int) -> string {
        return value < 10 ? "0" + value : "" + value;
    }

    function timecode() -> string {
        return root.pad(Math.floor(root.seconds / 3600)) + ":" + root.pad(Math.mod(Math.floor(root.seconds / 60), 60)) + ":" + root.pad(Math.mod(root.seconds, 60));
    }

    function index-of(panel: Panel) -> int {
        return panel == Panel.play ? 0 : panel == Panel.profile ? 1 : 2;
    }

    function panel-at(index: int) -> Panel {
        return index == 0 ? Panel.play : index == 1 ? Panel.profile : Panel.settings;
    }

    function show(next: Panel) {
        if next == root.target {
            return;
        }
        root.target = next;
        root.rewinding = true;
        root.sweeping = true;
        panel-switch.running = true;
        panel-switch.restart();
        sweep-timer.running = true;
        sweep-timer.restart();
    }

    function say(text: string, alarm: bool) {
        root.message = text;
        root.alarm = alarm;
        message-timer.running = true;
        message-timer.restart();
    }

    function launch() {
        if root.busy || root.playing {
            return;
        }
        root.crashed = false;
        if root.build == "" {
            root.install();
            return;
        }
        let launch = root.play();
        if launch == Launch.nick {
            root.say(@tr("НИК: 3–16 ЛАТИНСКИХ БУКВ, ЦИФР ИЛИ _"), true);
        } else if launch == Launch.failed {
            root.say(@tr("НЕ УДАЛОСЬ ЗАПУСТИТЬ ИГРУ, ПРОВЕРЬТЕ ВЕРСИЮ В НАСТРОЙКАХ"), true);
        }
    }

    function repair() {
        if !root.busy && !root.playing {
            root.crashed = false;
            root.install();
        }
    }

    function refuse() {
        root.say(@tr("ЗАКРОЙТЕ ИГРУ, ЧТОБЫ ИЗМЕНИТЬ"), false);
    }

    function join() {
        if !root.team-online {
            root.say(@tr("НЕТ СВЯЗИ С СЕРВЕРОМ, ПОПРОБУЙТЕ ПОЗЖЕ"), true);
            return;
        }
        root.join-team(root.join-text);
        root.join-text = "";
        root.join-edited("");
    }

    public function rejected(reason: Rejection) {
        if reason == Rejection.unknown {
            root.say(@tr("КОМАНДА С ТАКИМ КОДОМ НЕ НАЙДЕНА"), true);
        } else if reason == Rejection.full {
            root.say(@tr("В КОМАНДЕ НЕТ МЕСТА"), true);
        } else if reason == Rejection.locked {
            root.say(@tr("КОМАНДА СЕЙЧАС В ИГРЕ"), true);
        } else if reason == Rejection.nick-taken {
            root.say(@tr("ЭТОТ НИК УЖЕ ЕСТЬ В КОМАНДЕ"), true);
        } else {
            root.say(@tr("КОМАНДА НЕ ПРИНЯЛА ЗАПРОС"), true);
        }
    }

    public function leave() {
        if root.playing {
            root.say(@tr("СНАЧАЛА ЗАКРОЙТЕ ИГРУ"), true);
        } else {
            root.quit();
        }
    }

    function reveal(place: Place, missing: string) {
        if !root.open(place) {
            root.say(missing, false);
        }
    }

    public function finished(outcome: Outcome) {
        if outcome == Outcome.done {
            root.say(@tr("ВЕРСИЯ УСТАНОВЛЕНА"), false);
        } else if outcome == Outcome.cancelled {
            root.say(@tr("ЗАГРУЗКА ОТМЕНЕНА"), false);
        } else if outcome == Outcome.network {
            root.say(@tr("НЕТ СВЯЗИ С СЕРВЕРОМ, ПОПРОБУЙТЕ ПОЗЖЕ"), true);
        } else if outcome == Outcome.disk {
            root.say(@tr("НЕ УДАЛОСЬ ЗАПИСАТЬ ФАЙЛЫ, ПРОВЕРЬТЕ МЕСТО НА ДИСКЕ"), true);
        } else if outcome == Outcome.corrupt {
            root.say(@tr("ФАЙЛ ПРИШЁЛ ПОВРЕЖДЁННЫМ, ПОВТОРИТЕ ЗАГРУЗКУ"), true);
        } else {
            root.say(@tr("НЕ УДАЛОСЬ УСТАНОВИТЬ ВЕРСИЮ"), true);
        }
    }

    function status() -> string {
        if root.busy && root.preparing {
            return @tr("ПОДГОТОВКА");
        }
        if root.busy && !root.downloading {
            return @tr("ПРОВЕРКА {}%", Math.floor(root.progress * 100));
        }
        if root.busy {
            return @tr("ЗАГРУЗКА {}%", Math.floor(root.progress * 100));
        }
        if root.crashed {
            return @tr("ИГРА ВЫЛЕТЕЛА");
        }
        return root.build == "" ? @tr("ВЕРСИЯ НЕ УСТАНОВЛЕНА") : @tr("ВЕРСИЯ {}", root.build.to-uppercase());
    }

    panel-switch := Timer {
        interval: Theme.page-out;
        running: false;
        triggered => {
            root.panel = root.target;
            root.rewinding = false;
            self.running = false;
        }
    }

    sweep-timer := Timer {
        interval: Theme.sweep;
        running: false;
        triggered => {
            root.sweeping = false;
            self.running = false;
        }
    }

    message-timer := Timer {
        interval: root.alarm ? Theme.alarm : Theme.message;
        running: false;
        triggered => {
            root.message = "";
            self.running = false;
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.show(root.panel-at(Math.mod(root.index-of(root.target) + 2, 3)));
                return accept;
            }
            if event.text == Key.DownArrow {
                root.show(root.panel-at(Math.mod(root.index-of(root.target) + 1, 3)));
                return accept;
            }
            if event.text == Key.Escape && root.target != Panel.play {
                root.show(Panel.play);
                return accept;
            }
            if event.text == Key.Escape && root.busy {
                root.cancel();
                return accept;
            }
            if event.text == Key.Return && root.panel == Panel.play {
                root.launch();
                return accept;
            }
            return reject;
        }

        Rectangle {
            transform-scale-y: root.powered ? 100% : 0.5%;
            opacity: root.powered ? 1 : 0;
            animate transform-scale-y, opacity { duration: Theme.power-on; easing: ease-out; }

            Rectangle {
                height: Theme.frame * 2 + 8px;
                y: 0px;

                TouchArea {
                    moved => {
                        root.drag-window(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    }
                }
            }

            Rectangle {
                x: root.glitch-shift;

                VerticalLayout {
                    padding-left: Theme.edge;
                    padding-right: Theme.edge;
                    padding-top: Theme.frame - 4px;
                    padding-bottom: Theme.frame - 3px;
                    spacing: 0px;

                    HorizontalLayout {
                        height: Theme.osd-line;
                        spacing: 10px;
                        alignment: start;

                        if !root.busy: VerticalLayout {
                            alignment: center;
                            RecDot { opacity: root.blink ? 1 : 0; }
                        }
                        if !root.busy: Osd { text: "REC"; color: Theme.text; }
                        if root.busy: HorizontalLayout {
                            spacing: 1px;
                            alignment: center;
                            VerticalLayout { alignment: center; Marker { } }
                            VerticalLayout { alignment: center; Marker { } }
                        }
                        if root.busy: Osd { text: @tr("ПЕРЕМОТКА"); color: Theme.text; }
                        Osd { text: root.timecode(); }
                    }

                    Rectangle { height: Theme.osd-gap - 4px; }

                    Logo { glitch: root.logo-glitch; }

                    Rectangle { height: 21px; }
                    Rectangle { height: 1px; background: Theme.line; }
                    Rectangle { height: 19px; }

                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        Rectangle {
                            width: Theme.menu-width;

                            VerticalLayout {
                                y: -9px;
                                alignment: start;

                                MenuItem {
                                    label: root.busy ? @tr("ЗАГРУЗКА") : @tr("ИГРАТЬ");
                                    active: root.target == Panel.play;
                                    activated => { root.show(Panel.play); }
                                }
                                MenuItem {
                                    label: @tr("ПРОФИЛЬ");
                                    active: root.target == Panel.profile;
                                    activated => { root.show(Panel.profile); }
                                }
                                MenuItem {
                                    label: @tr("НАСТРОЙКИ");
                                    active: root.target == Panel.settings;
                                    activated => { root.show(Panel.settings); }
                                }
                                MenuItem {
                                    label: @tr("ВЫХОД");
                                    activated => { root.leave(); }
                                }
                            }
                        }

                        Rectangle { width: Theme.gap; }
                        Rectangle { width: 1px; background: Theme.line; }
                        Rectangle { width: Theme.gap - 1px; }

                        panel-area := Rectangle {
                            horizontal-stretch: 1;

                            Rectangle {
                                x: root.rewinding ? 8px : 0px;
                                width: parent.width;
                                height: parent.height;
                                opacity: root.rewinding ? 0 : 1;
                                animate x, opacity {
                                    duration: root.rewinding ? Theme.page-out : Theme.page-in;
                                    easing: ease-in-out;
                                }

                                if root.panel == Panel.play: PlayPanel {
                                    slots: root.slots;
                                    online: root.team-online;
                                    team-code: root.team-code;
                                    team-cells: root.team-cells;
                                    join-cells: root.join-cells;
                                    join-text <=> root.join-text;
                                    blink: root.blink;
                                    busy: root.busy;
                                    installed: root.build != "";
                                    playing: root.playing;
                                    join-edited(text) => { root.join-edited(text); }
                                    join => { root.join(); }
                                    leave => { root.leave-team(); }
                                    kick(index) => { root.kick(index); }
                                    launch => { root.launch(); }
                                    cancel => { root.cancel(); }
                                }
                                if root.panel == Panel.profile: ProfilePanel {
                                    nick <=> root.nick;
                                    presets: root.presets;
                                    skin: root.skin;
                                    locked: root.playing;
                                    front: root.front;
                                    back: root.back;
                                    nick-edited(text) => { root.nick-edited(text); }
                                    select-skin(index) => { root.select-skin(index); }
                                    refused => { root.refuse(); }
                                }
                                if root.panel == Panel.settings: SettingsPanel {
                                    version: root.version;
                                    build: root.build;
                                    memory: root.memory;
                                    auto-memory: root.auto-memory;
                                    window-mode: root.window-mode;
                                    language: root.language;
                                    after-launch: root.after-launch;
                                    locked: root.playing;
                                    refused => { root.refuse(); }
                                    adjust(choice, delta) => { root.adjust(choice, delta); }
                                    open-home => { root.reveal(Place.home, @tr("ВЕРСИЯ ЕЩЁ НЕ УСТАНОВЛЕНА")); }
                                    repair => { root.repair(); }
                                    open-logs => { root.reveal(Place.logs, @tr("ЛОГОВ ПОКА НЕТ")); }
                                    open-screenshots => { root.reveal(Place.screenshots, @tr("СКРИНШОТОВ ПОКА НЕТ")); }
                                }
                            }

                            sweep := Rectangle {
                                y: -self.height;
                                height: 2px;
                                background: #ffffff26;
                                opacity: root.sweeping ? 1 : 0;
                            }
                        }
                    }

                    Rectangle { height: Theme.osd-gap - 5px; }

                    HorizontalLayout {
                        height: Theme.osd-line;
                        spacing: Theme.gap;

                        HorizontalLayout {
                            min-width: Theme.menu-width + Theme.gap;
                            horizontal-stretch: 0;

                            Osd {
                                text: root.message != "" ? root.message : root.status();
                                color: root.message != "" ? (root.alarm ? Theme.rec : Theme.text) : root.crashed ? Theme.rec : Theme.text-mute;
                                horizontal-stretch: 1;
                                animate color { duration: Theme.hover; easing: ease-out; }
                            }
                            if root.busy && root.downloading && root.message == "": Osd {
                                text: @tr("{}.{} МБ/С", Math.floor(Math.round(root.speed * 10) / 10), Math.mod(Math.round(root.speed * 10), 10));
                                horizontal-alignment: right;
                            }
                            if root.crashed && root.message == "": Osd {
                                text: @tr("ОТКРЫТЬ ЛОГ");
                                color: log-area.has-hover ? Theme.text : Theme.text-mute;
                                horizontal-alignment: right;
                                animate color { duration: Theme.hover; easing: ease-out; }

                                log-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.reveal(Place.latest-log, @tr("ЛОГОВ ПОКА НЕТ")); }
                                }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;

                            Rectangle {
                                y: (parent.height - self.height) / 2;
                                height: 2px;
                                background: Theme.line;
                                opacity: root.busy ? 1 : 0;
                                animate opacity { duration: Theme.page-in; easing: ease-out; }

                                Rectangle {
                                    x: 0px;
                                    width: parent.width * clamp(root.progress, 0, 1);
                                    background: Theme.text;
                                    animate width { duration: Theme.fill; easing: ease-out; }
                                }
                            }
                        }
                        Rectangle {
                            width: date.preferred-width;

                            date := Osd { x: 2px; text: @tr("ОКТ. 08 1996   AM 03:12"); }
                        }
                    }
                }
            }

            WindowButton {
                x: root.width - Theme.edge - 21px - 31px - 8px;
                y: Theme.frame - 11px;
                action: WindowAction.minimize;
                clicked => { root.minimized = true; }
            }
            WindowButton {
                x: root.width - Theme.edge - 21px;
                y: Theme.frame - 11px;
                action: WindowAction.close;
                clicked => { root.leave(); }
            }

            VhsLayer {
                noise: root.noise;
                scanlines: root.scanlines;
                noise-boost: root.rewinding ? 0.3 : root.glitch-shift != 0px ? 0.12 : 0;
                tracking: root.tracking;
                tracking-time: root.tracking-time;
                animate noise-boost { duration: Theme.page-out; easing: ease-out; }
            }
        }
    }
}
